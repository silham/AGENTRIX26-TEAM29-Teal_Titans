# Core
ENVIRONMENT=development

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/helplk

# Auth — MUST equal the NextAuth AUTH_SECRET on the frontend (HS256 JWT)
AUTH_SECRET=change-me-shared-with-nextauth
JWT_ALGORITHM=HS256

# Admin allowlist for the knowledge-base uploader (comma-separated emails).
# These accounts get role=admin in their JWT and can reach /admin/*.
ADMIN_EMAILS=

# CORS (frontend origin; comma-separate for multiple)
FRONTEND_ORIGIN=http://localhost:3000

# LLMs (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

# Storage
STORAGE_BUCKET=documents
STORAGE_DIR=./.storage
