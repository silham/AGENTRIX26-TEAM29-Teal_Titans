# Variables consumed by docker-compose.yml. In Coolify, set these under the
# Docker Compose resource's "Environment Variables" tab — do not commit a
# real .env file.

# --- External Postgres + pgvector (e.g. Supabase or Neon free tier) ---
# Must already have (or be able to create) the `vector` extension — the
# backend runs `CREATE EXTENSION IF NOT EXISTS vector` on startup.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Shared auth secret — MUST be identical on frontend and backend (HS256 JWT) ---
AUTH_SECRET=change-me-shared-with-nextauth

# --- Public URLs (set these to real domains once Coolify assigns them) ---
# Backend URL as reachable from the citizen's BROWSER (baked into the
# frontend build — changing it requires a rebuild, not just a restart).
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
# Frontend origin, for the backend's CORS allowlist. Comma-separate for more than one.
FRONTEND_ORIGIN=https://yourdomain.com

# --- Admin allowlist (comma-separated emails; grants /admin/* access) ---
ADMIN_EMAILS=

# --- LLMs (free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
